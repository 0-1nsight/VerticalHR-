# =============================================================================
# VerticalHR Production & Local Development Environment Variables
# =============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://verticalhr_app:app_secure_password_dev@localhost:5432/verticalhr_dev
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=verticalhr_dev
SQL_USER=verticalhr_app
SQL_PASSWORD=app_secure_password_dev
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres_admin_dev_password

# Authentication & Session Security
SESSION_SECRET=replace_with_a_cryptographically_secure_random_64_char_secret
JWT_SECRET=replace_with_a_secure_jwt_signing_secret_min_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Object Storage (S3-Compatible: AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=minio # minio | aws | r2
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=verticalhr-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadminpassword

# Transactional Email Provider (Resend / SendGrid / Postmark / AWS SES / SMTP)
EMAIL_PROVIDER=mailpit # mailpit | resend | sendgrid | postmark | ses
EMAIL_API_KEY=
EMAIL_FROM=VerticalHR Notifications <no-reply@verticalhrm.com>
SMTP_HOST=localhost
SMTP_PORT=1025

# Observability & Monitoring
SENTRY_DSN=
LOG_LEVEL=info
LOG_FORMAT=json

# Multi-Tenancy Defaults
DEFAULT_TENANT_COUNTRY=Jamaica
DEFAULT_TENANT_CURRENCY=JMD
DEFAULT_TENANT_TIMEZONE=America/Jamaica
