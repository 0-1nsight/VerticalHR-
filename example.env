# =============================================================================
# VerticalHR Example Environment Configuration (example.env)
# Simulated local development and testing values
# =============================================================================

# Node Environment & Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://verticalhr_app:app_secure_password_dev@localhost:5432/verticalhr_dev
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=verticalhr_dev
SQL_USER=verticalhr_app
SQL_PASSWORD=app_secure_password_dev
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres_admin_dev_password

# Authentication & Session Security
SESSION_SECRET=dev_session_secret_f22ba87d_7835_40a7_a24e_a466990d88f5_super_secure_64_bytes
JWT_SECRET=dev_jwt_signing_secret_verticalhr_2026_super_key_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Field-Level Encryption Key (for Bank Details, Tax IDs, TRN)
ENCRYPTION_KEY_BASE64=dGVzdF9lbmNyeXB0aW9uX2tleV8zMl9ieXRlc19mb3JfdmF1bHQ=

# Object Storage (S3-Compatible: AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=verticalhr-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadminpassword

# Transactional Email Provider (Mailpit / Resend / SendGrid / Postmark / SES)
EMAIL_PROVIDER=mailpit
EMAIL_API_KEY=simulated_resend_api_key_test_sandbox
EMAIL_FROM=VerticalHR Platform <notifications@verticalhrm.internal>
SMTP_HOST=localhost
SMTP_PORT=1025

# Observability & Monitoring
SENTRY_DSN=https://simulated_dsn_public_key@sentry.io/4508920129
LOG_LEVEL=debug
LOG_FORMAT=json

# Multi-Tenancy Defaults
DEFAULT_TENANT_COUNTRY=Jamaica
DEFAULT_TENANT_CURRENCY=JMD
DEFAULT_TENANT_TIMEZONE=America/Jamaica
